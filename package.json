{
  "name": "@superserif/ui",
  "version": "0.1.1",
  "description": "Super Serif control panel — parameters, curves, presets for creative dev. dat.gui, the studio way.",
  "type": "module",
  "scripts": {
    "dev": "vite --port 4402 --strictPort",
    "build": "vite build -c vite.lib.config.ts && rm -f dist/styles.js dist/styles.js.map dist/styles.d.ts && FORMAT=iife vite build -c vite.lib.config.ts",
    "build:playground": "vite build",
    "preview": "vite preview --port 4402",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "author": "Super Serif <tools@superserif.studio> (https://superserif.studio)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/superserif/superserif-lib-ui.git"
  },
  "homepage": "https://github.com/superserif/superserif-lib-ui#readme",
  "keywords": [
    "gui",
    "control-panel",
    "dat.gui",
    "tweakpane",
    "creative-coding",
    "three.js",
    "shaders",
    "ui"
  ],
  "sideEffects": [
    "./dist/auto.js",
    "./dist/ssui.iife.js",
    "*.css"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/ssui.iife.js",
  "jsdelivr": "./dist/ssui.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./auto": {
      "types": "./dist/auto.d.ts",
      "import": "./dist/auto.js"
    },
    "./css": "./dist/ssui.css",
    "./tokens": "./src/styles/tokens.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/styles/tokens.css",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
